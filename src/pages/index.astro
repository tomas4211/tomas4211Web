// ── Apply translations to all [data-i18n] elements ───────────────────────

function applyLang(lang: string) {
  const dict = dicts[lang] ?? dicts['es'];
  document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
    const key = el.dataset.i18n!;
    const val = dict[key];
    if (val !== undefined) el.textContent = val;
  });
  // Update html attribute
  document.documentElement.setAttribute('data-lang', lang);
  document.getElementById('portfolio-root')?.setAttribute('data-lang', lang);
  // Update navbar toggle visual
  const btnEs = document.getElementById('btn-es') as HTMLButtonElement | null;
  const btnEn = document.getElementById('btn-en') as HTMLButtonElement | null;
  if (btnEs && btnEn) {
    if (lang === 'es') {
      Object.assign(btnEs.style, { background: 'rgba(255,0,255,0.2)', color: '#ff00ff', textShadow: '0 0 8px #ff00ff' });
      Object.assign(btnEn.style, { background: 'transparent', color: 'rgba(255,255,255,0.3)', textShadow: 'none' });
    } else {
      Object.assign(btnEn.style, { background: 'rgba(0,255,255,0.2)', color: '#00ffff', textShadow: '0 0 8px #00ffff' });
      Object.assign(btnEs.style, { background: 'transparent', color: 'rgba(255,255,255,0.3)', textShadow: 'none' });
    }
  }
}

// Expose to navbar inline onclick handlers
(window as any).__setLang = (lang: string) => {
  applyLang(lang);
  // Tell the React terminal island to also switch
  window.dispatchEvent(new CustomEvent('setlang', { detail: { lang } }));
};

// Listen for changes coming FROM the terminal
window.addEventListener('langchange', (e: Event) => {
  applyLang((e as CustomEvent).detail.lang);
});

// ── Hover glow on id cards ────────────────────────────────────────────────
document.querySelectorAll<HTMLElement>('.pm-card, .cli-card').forEach(el => {
  el.addEventListener('mousemove', (e: MouseEvent) => {
    const r = el.getBoundingClientRect();
    el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
    el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
  });
});

// ── Conic-gradient on milestone cards ────────────────────────────────────
const colorMap: Record<string, string> = { pink: '#ff00ff', blue: '#00ffff', yellow: '#fefe00' };
document.querySelectorAll<HTMLElement>('.project-card').forEach(card => {
  const ring  = card.querySelector<HTMLElement>('.conic-ring')!;
  const color = colorMap[card.dataset.color ?? 'blue'] ?? '#00ffff';
  card.addEventListener('mouseenter', () => {
    ring.style.opacity = '1';
    ring.style.background = `conic-gradient(from 0deg, ${color}, transparent 25%, ${color}88, transparent 50%, ${color}, transparent 75%, ${color}88)`;
    ring.style.padding = '1px';
    ring.style.webkitMask = 'linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0)';
    ring.style.webkitMaskComposite = 'xor';
    ring.style.maskComposite = 'exclude';
  });
  card.addEventListener('mouseleave', () => { ring.style.opacity = '0'; });
});

// ── Terminal CTA wires to React island ───────────────────────────────────
document.getElementById('open-terminal')?.addEventListener('click', () => {
  document.querySelector<HTMLButtonElement>('[title="Open Terminal"]')?.click();
});
</script>
