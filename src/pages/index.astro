    'hero.tagline': 'Senior Frontend Architect building high-performance systems and engineering culture in Caracas — since 2022.',
    'hero.ctaBtn': 'Initialize Session',
    'hero.ctaHint': 'Type fastfetch after opening for specs',
    'identity.pm.label': 'Executive Leadership',
    'identity.pm.title': 'Project Management',
    'identity.pm.description': 'Backlog refinement · Sprint planning · Stakeholder alignment\nCredix (Angular 19) · Finanve PWA · Multi-tenant SSO',
