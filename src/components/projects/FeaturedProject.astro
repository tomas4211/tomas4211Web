---
import { es, en } from '../../i18n/index';
import { ExternalLink, Server, Shield, Cloud, Activity } from 'lucide-astro';

const dicts = { es, en };
const initial = 'es';
const d = dicts[initial];
---

<section class="max-w-7xl mx-auto px-6 py-20 relative">
  <div class="flex items-center gap-4 mb-12">
    <span class="font-mono text-[10px] uppercase tracking-[0.4em] text-gray-500" data-i18n="featuredProject.heading">
      {d.featuredProject.heading}
    </span>
    <div class="h-px flex-1 bg-white/5"></div>
  </div>

  <div class="relative rounded-2xl overflow-hidden group"
       style="background:rgba(10,10,15,0.4); backdrop-filter:blur(20px); border:1px solid rgba(0,255,255,0.15); box-shadow:0 0 40px rgba(0,255,255,0.03);">
    
    <!-- Neon Corner Accents -->
    <div class="absolute top-0 left-0 w-12 h-px bg-gradient-to-r from-[#00ffff] to-transparent"></div>
    <div class="absolute top-0 left-0 w-px h-12 bg-gradient-to-b from-[#00ffff] to-transparent"></div>
    <div class="absolute bottom-0 right-0 w-12 h-px bg-gradient-to-l from-[#ff00ff] to-transparent"></div>
    <div class="absolute bottom-0 right-0 w-px h-12 bg-gradient-to-t from-[#ff00ff] to-transparent"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2">
      <!-- Left: Visual Placeholder -->
      <div class="relative min-h-[300px] lg:min-h-full p-8 flex flex-col justify-center items-center overflow-hidden border-b lg:border-b-0 lg:border-r border-white/5"
           style="background:radial-gradient(circle at center, rgba(0,255,255,0.05) 0%, transparent 70%);">
        <div class="absolute inset-0 opacity-20"
             style="background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px); background-size: 20px 20px;"></div>
        
        <!-- Mockup Placeholder -->
        <div class="relative w-full max-w-sm aspect-[4/3] rounded-xl overflow-hidden border border-white/10 flex items-center justify-center group-hover:scale-105 transition-transform duration-700"
             style="background:rgba(0,0,0,0.5); box-shadow:0 20px 40px -10px rgba(0,0,0,0.8);">
          <div class="absolute top-0 inset-x-0 h-6 bg-white/5 border-b border-white/10 flex items-center px-3 gap-1.5">
            <div class="w-2 h-2 rounded-full bg-red-500/50"></div>
            <div class="w-2 h-2 rounded-full bg-yellow-500/50"></div>
            <div class="w-2 h-2 rounded-full bg-green-500/50"></div>
          </div>
          <p class="font-mono text-xs text-gray-500 uppercase tracking-widest">[ Captura UpCambios ]</p>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="p-8 md:p-12">
        <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
          <div>
            <h3 class="text-3xl font-black uppercase tracking-tight text-white mb-2" data-i18n="featuredProject.title">
              {d.featuredProject.title}
            </h3>
            <p class="text-[#ff00ff] font-mono text-xs uppercase tracking-widest" data-i18n="featuredProject.subtitle">
              {d.featuredProject.subtitle}
            </p>
          </div>
          <a href="https://upcambiosve.com" target="_blank" rel="noopener"
             class="shrink-0 flex items-center gap-2 px-4 py-2 rounded font-mono text-[10px] uppercase tracking-widest text-[#00ffff] hover:bg-[#00ffff]/10 transition-colors border border-[#00ffff]/30">
            <span data-i18n="featuredProject.cta">{d.featuredProject.cta}</span>
            <ExternalLink class="w-3 h-3" />
          </a>
        </div>

        <!-- Tech Stack Badges -->
        <div class="flex flex-wrap gap-2 mb-10">
          {['React 19', 'TypeScript', 'Node.js', 'PostgreSQL', 'AWS S3 / R2'].map(tech => (
            <span class="px-2.5 py-1 rounded-md text-[10px] font-mono border border-white/10 text-gray-400 bg-white/5">
              {tech}
            </span>
          ))}
        </div>

        <!-- Features Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-white">
              <Shield class="w-4 h-4 text-[#ff00ff]" />
              <h4 class="font-bold text-sm" data-i18n="featuredProject.features.kyc.title">{d.featuredProject.features.kyc.title}</h4>
            </div>
            <p class="text-xs text-gray-500 font-mono leading-relaxed" data-i18n="featuredProject.features.kyc.desc">
              {d.featuredProject.features.kyc.desc}
            </p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2 text-white">
              <Server class="w-4 h-4 text-[#00ffff]" />
              <h4 class="font-bold text-sm" data-i18n="featuredProject.features.admin.title">{d.featuredProject.features.admin.title}</h4>
            </div>
            <p class="text-xs text-gray-500 font-mono leading-relaxed" data-i18n="featuredProject.features.admin.desc">
              {d.featuredProject.features.admin.desc}
            </p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2 text-white">
              <Cloud class="w-4 h-4 text-yellow-400" />
              <h4 class="font-bold text-sm" data-i18n="featuredProject.features.qa.title">{d.featuredProject.features.qa.title}</h4>
            </div>
            <p class="text-xs text-gray-500 font-mono leading-relaxed" data-i18n="featuredProject.features.qa.desc">
              {d.featuredProject.features.qa.desc}
            </p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2 text-white">
              <Activity class="w-4 h-4 text-green-400" />
              <h4 class="font-bold text-sm" data-i18n="featuredProject.features.prod.title">{d.featuredProject.features.prod.title}</h4>
            </div>
            <p class="text-xs text-gray-500 font-mono leading-relaxed" data-i18n="featuredProject.features.prod.desc">
              {d.featuredProject.features.prod.desc}
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
